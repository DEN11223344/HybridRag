# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False
CPU_NUM_THREADS=4

# Storage paths
UPLOAD_DIR=data/uploads
EXTRACTED_DIR=data/extracted
PROCESSED_DIR=data/processed

# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=pdf_hybrid_rag

# Models (Local CPU Inference)
DENSE_MODEL=BAAI/bge-small-en-v1.5
DENSE_DIM=384
SPLADE_MODEL=prithivida/Splade_PP_en_v1
RERANKER_MODEL=BAAI/bge-reranker-base

# Ingestion & Chunking parameters
TARGET_CHUNK_SIZE=512
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=100
MAX_CHUNK_SIZE=700
OCR_CHAR_THRESHOLD=40
BATCH_SIZE=16

# Retrieval & Reranker parameters
BM25_TOP_K=20
SPLADE_TOP_K=20
DENSE_TOP_K=20
RRF_K=60
RERANK_TOP_K=5

# Generation / LLM Configuration
# Options: mock, ollama, openai, gemini
LLM_PROVIDER=mock
LLM_MODEL=llama3
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
